# ===== 运行配置 =====
# 数据库（默认 SQLite，切 PostgreSQL 只需改这一行）
DATABASE_URL=sqlite:///./data/studio.db

# LLM 提供方：mock = 离线可跑（默认）；openai_compatible = 接真实模型
LLM_PROVIDER=mock

# 真实模型接入（任何 OpenAI 兼容网关：DeepSeek / Qwen / vLLM / Ollama）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60

# Agent 运行时保护
MAX_TOOL_STEPS=4
MAX_ATTEMPTS=2

# 人工审核闸门：true 时创意簇产出后暂停，等待 /approve
HUMAN_APPROVAL=true
