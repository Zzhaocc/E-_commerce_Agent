# ===== 运行环境 =====
# development / staging / production，仅用于标注与日志，不改变业务逻辑
APP_ENV=development
DEBUG=false

# ===== 存储 =====
# 默认 SQLite（零依赖）；换 PostgreSQL 只需改这一行并安装驱动：
#   pip install "psycopg[binary]"  →  postgresql+psycopg://user:pass@host:5432/crossborderops
DATABASE_URL=sqlite:///./data/studio.db
# 数据目录（SQLite 文件、临时导出物）
DATA_DIR=./data

# ===== 模型 =====
# mock = 离线规则型实现（默认，无需任何密钥）；openai_compatible = 接真实模型
LLM_PROVIDER=mock
# 任何 OpenAI 兼容网关：DeepSeek / Qwen / vLLM / Ollama / 中转网关
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60

# ===== Agent 运行时保护 =====
# 单个 Agent 允许的工具调用轮数上限（防死循环烧钱）
MAX_TOOL_STEPS=4
# 输出契约校验失败后的最大尝试次数
MAX_ATTEMPTS=2
# 人工审核闸门：true 时创意簇产出后暂停，等待 POST /api/runs/{id}/approve
HUMAN_APPROVAL=true

# ===== 成本核算（美元 / 千 token，用于成本看板归因）=====
COST_PER_1K_IN=0.00027
COST_PER_1K_OUT=0.0011

# ===== 接入与可观测 =====
# 允许的跨域来源，逗号分隔；* 仅供本地开发
CORS_ORIGINS=*
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志格式：text（本地阅读）/ json（采集到 Loki、ELK、CloudWatch）
LOG_FORMAT=text
# 请求关联 ID 的响应头名
REQUEST_ID_HEADER=X-Request-ID
# 是否暴露 /docs、/redoc、/openapi.json（生产建议关闭）
DOCS_ENABLED=true
